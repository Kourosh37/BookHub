DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookhub?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
NEXTAUTH_URL="http://localhost:3000"
# Generate independent secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
OTP_SECRET=""
ADMIN_PANEL_SECRET=""
CRON_SECRET=""
SESSION_EXPIRES_DAYS="7"
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=""
ADMIN_USERS_PAGE_SIZE_DEFAULT="50"
# Enable only behind an ingress that OVERWRITES untrusted X-Forwarded-For headers.
TRUST_PROXY_HEADERS="false"
ADMIN_LOGIN_RATE_LIMIT_MAX="5"
OTP_EXPIRES_MINUTES="2"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_RATE_LIMIT_IP_MAX="10"
OTP_RATE_LIMIT_IP_WINDOW_SECONDS="60"
OTP_RATE_LIMIT_PHONE_MAX="5"
OTP_RATE_LIMIT_PHONE_WINDOW_SECONDS="300"
OTP_VERIFY_RATE_LIMIT_IP_MAX="30"
OTP_ATTEMPT_WINDOW_MINUTES="15"
OTP_ATTEMPT_MAX="5"
OTP_LOCK_MINUTES="30"
LOGIN_PASSWORD_RATE_LIMIT_IP_MAX="20"
LOGIN_PASSWORD_RATE_LIMIT_IP_WINDOW_SECONDS="60"
AVATAR_UPLOAD_RATE_LIMIT_USER_MAX="10"
MAX_PROFILE_IMAGE_MB="2"
SMS_API_KEY=""
SMS_TEMPLATE_OTP=""
SMS_TEMPLATE_BOOKING_REMINDER=""
SMS_TEMPLATE_BOOKING_CANCELED=""
SMS_TEMPLATE_BOOKING_CREATED_HOST=""
SMS_TEMPLATE_BOOKING_CREATED_GUEST=""
UNBOOKED_SLOT_RETENTION_DAYS="30"
OTP_RETENTION_DAYS="7"
LOG_LEVEL="info"
PRISMA_MIGRATE_ON_START="true"
