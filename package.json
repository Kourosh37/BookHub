{
  "name": "bookhubtmp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.12 <27",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && next build --webpack",
    "start": "next start",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run prisma:generate",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:infra": "docker compose -p bookhub-tests -f tests/docker-compose.yml up -d --wait",
    "test:migrate": "tsx tests/migrate.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e",
    "test:unit": "vitest run tests/unit tests/components",
    "notifications:retry": "tsx scripts/retry-notification.ts"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "16.2.9",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.10",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.9",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-multi-date-picker": "^4.5.2",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "26.1.0",
    "playwright-core": "1.61.0",
    "postcss": "^8",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "7.3.1",
    "vitest": "4.1.9"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
